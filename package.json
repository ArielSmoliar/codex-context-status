{
  "name": "codex-context-status",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local context and cache inspector for Codex desktop",
  "scripts": {
    "benchmark": "python3 scripts/benchmark_refresh.py",
    "build": "python3 mcp/build_widget.py && npm run build:plugin",
    "build:plugin": "node scripts/build_plugin.mjs",
    "test:plugin": "node tests/test-plugin.mjs",
    "test:unit": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:mcp": "node tests/test-mcp.mjs",
    "test:install": "node tests/test-install-mcp.mjs",
    "test:ui": "node tests/test-mcp-ui.mjs",
    "test:landing": "node tests/test-landing.mjs",
    "test": "npm run test:unit && npm run test:mcp && npm run test:install && npm run test:ui"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.58.2"
  },
  "engines": {
    "node": ">=20"
  }
}
